{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source lifecycle status",
  "type": "object",
  "required": ["id", "type", "state"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "state": { "enum": ["discovered", "configured", "initialising", "connecting", "active", "degraded", "disconnected", "failed", "stopping", "stopped"] },
    "message": { "type": "string" }
  },
  "additionalProperties": false
}

