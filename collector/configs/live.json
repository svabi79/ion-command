{
  "branding": {
    "productName": "ION COMMAND",
    "subtitle": "Global Geospatial Operations & HF Propagation Command Center"
  },
  "server": {
    "listenAddress": "127.0.0.1:7810",
    "writeTimeoutSeconds": 10
  },
  "pipeline": {
    "queueCapacity": 32768,
    "clientQueueCapacity": 8192,
    "workerCount": 4,
    "retainLatest": [
      "spaceweather.state",
      "ionosphere.sounding"
    ]
  },
  "recording": {
    "enabled": true,
    "directory": "../../data/recordings",
    "flushIntervalSeconds": 1,
    "maxTotalGigabytes": 40
  },
  "sources": [
    {
      "id": "pskreporter-primary",
      "type": "pskreporter.mqtt",
      "enabled": true,
      "broker": "tcp://mqtt.pskreporter.info:1883",
      "topic": "pskr/filter/v2/#"
    },
    {
      "id": "wsjtx-local",
      "type": "wsjtx.udp",
      "enabled": false,
      "broker": "127.0.0.1:2237"
    },
    {
      "id": "swpc-primary",
      "type": "spaceweather.swpc",
      "enabled": true
    },
    {
      "id": "kc2g-primary",
      "type": "ionosonde.kc2g",
      "enabled": true,
      "pollSeconds": 600
    }
  ]
}
