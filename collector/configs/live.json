{
  "branding": {
    "productName": "ION COMMAND",
    "subtitle": "Global Geospatial Operations & HF Propagation Command Center"
  },
  "server": {
    "listenAddress": "127.0.0.1:7810",
    "writeTimeoutSeconds": 10
  },
  "pipeline": {
    "queueCapacity": 32768,
    "clientQueueCapacity": 49152,
    "workerCount": 4,
    "retainLatest": [
      "spaceweather.state",
      "ionosphere.sounding",
      "aviation.aircraft"
    ]
  },
  "recording": {
    "enabled": false,
    "directory": "../data/recordings",
    "flushIntervalSeconds": 1,
    "maxTotalGigabytes": 20
  },
  "sources": [
    {
      "id": "pskreporter-primary",
      "type": "pskreporter.mqtt",
      "enabled": true,
      "broker": "tcp://mqtt.pskreporter.info:1883",
      "topic": "pskr/filter/v2/#"
    },
    {
      "id": "wsjtx-local",
      "type": "wsjtx.udp",
      "enabled": false,
      "broker": "127.0.0.1:2237"
    },
    {
      "id": "swpc-primary",
      "type": "spaceweather.swpc",
      "enabled": true
    },
    {
      "id": "kc2g-primary",
      "type": "ionosonde.kc2g",
      "enabled": true,
      "pollSeconds": 600
    },
    {
      "id": "blitzortung-primary",
      "type": "lightning.blitzortung",
      "enabled": true
    },
    {
      "id": "usgs-primary",
      "type": "earthquake.usgs",
      "enabled": true
    },
    {
      "id": "celestrak-amateur",
      "type": "orbital.celestrak",
      "enabled": true
    },
    {
      "id": "adsb-region-example",
      "type": "aviation.adsb",
      "enabled": true,
      "latitude": 50.0,
      "longitude": 8.0,
      "radiusNm": 250,
      "pollSeconds": 60
    },
    {
      "id": "opensky-world",
      "type": "aviation.opensky",
      "enabled": true,
      "pollSeconds": 1800
    },
    {
      "id": "rbn-primary",
      "type": "hamradio.rbn",
      "enabled": false,
      "login": "N0CALL"
    },
    {
      "id": "aprsis-primary",
      "type": "aprs.is",
      "enabled": false,
      "login": "NOCALL"
    }
  ]
}
