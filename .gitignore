# Cached raw and converted NASA downloads (tools/fetch-earth-textures.py
# rebuilds all of it; the day/night textures alone can be several hundred MB
# at full resolution and must never enter the repository). Only the hand
# written attribution file in this directory is tracked.
unreal/SourceAssets/NASA/*.jpg
unreal/SourceAssets/NASA/*.png
unreal/SourceAssets/NASA/*.exr
unreal/SourceAssets/NASA/*.tif

# Personal collector setup (callsign, home QTH) - never published
collector/configs/local.json
